@model IEnumerable<TESTER.Models.InsuredPerson>

@{

    Layout = "HomeLayout";
}

<h2>Search by Main Member ID</h2>

<form asp-action="Search" method="get" class="form-inline mb-3">
    <div class="form-group">
        <label for="mainMemberId">Main Member ID:</label>
        <input type="text" name="mainMemberId" class="form-control ml-2" placeholder="Enter ID" />
    </div>
    <button type="submit" class="btn btn-primary ml-2">Search</button>
</form>

@if (Model != null && Model.Any())
{
    <p><strong>Showing results for Main Member ID:</strong> @ViewBag.MainMemberId</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Main Member ID</th>
                <th>Relationship</th>
                <th>First Names</th>
                <th>Surname</th>
                <th>Date of Birth</th>
                <th>ID Number</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in Model)
            {
                <tr>
                    <td>@person.MainMemberId</td>
                    <td>@person.RelationshipToPrincipalMember</td>
                    <td>@person.FirstNames</td>
                    <td>@person.Surname</td>
                    <td>@person.DateOfBirth.ToString("yyyy-MM-dd")</td>
                    <td>@person.IdNumber</td>
                    <td>
                        <a asp-action="Update" asp-route-id="@person.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@person.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (ViewBag.MainMemberId != null)
{
    <p>No results found for Main Member ID: <strong>@ViewBag.MainMemberId</strong></p>
}

<div class="back">
    <a asp-controller="DashBoard" asp-action="Index" class="button">Back</a>
</div>
