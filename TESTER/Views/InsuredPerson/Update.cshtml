@model InsuredPerson

@{

    Layout = "HomeLayout";
}

<h2>Edit Insured Person</h2>

<form asp-action="Update" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>MainMemberId</label>
        <input asp-for="MainMemberId" class="form-control" />
    </div>
    <div class="form-group">
        <label>Relationship</label>
        <input asp-for="RelationshipToPrincipalMember" class="form-control" />
    </div>
    <div class="form-group">
        <label>First Names</label>
        <input asp-for="FirstNames" class="form-control" />
    </div>
    <div class="form-group">
        <label>Surname</label>
        <input asp-for="Surname" class="form-control" />
    </div>
    <div class="form-group">
        <label>Date of Birth</label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>ID Number</label>
        <input asp-for="IdNumber" class="form-control" />
    </div>
    <button type="submit" class="button">Save Changes</button>
    <a asp-controller="DashBoard" asp-action="Index" class="button">Back</a>
</form>
<div class="back">
    
</div>